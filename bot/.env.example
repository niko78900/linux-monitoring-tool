DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

MONITORING_API_BASE_URL=http://127.0.0.1:4040/api
POLL_INTERVAL_SECONDS=30
ALERT_CONSUMER_API_TOKEN=
DISCORD_ALERT_CURSOR_FILE=/var/lib/linux-monitoring/discord_alert_cursor.json
DISCORD_ALERT_REPLAY_ON_FIRST_START=false

# Optional: override where /status schedule settings are persisted.
# Relative paths are resolved from the bot directory.
STATUS_SCHEDULE_STATE_FILE=status_schedule_state.json
