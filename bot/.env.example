DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

MONITORING_API_BASE_URL=http://127.0.0.1:4040/api
POLL_INTERVAL_SECONDS=30
ALERT_CONSUMER_API_TOKEN=
DISCORD_ALERT_CURSOR_FILE=/var/lib/linux-monitor/state/bot/discord_alert_cursor.json
DISCORD_ALERT_REPLAY_ON_FIRST_START=false

# Optional: override where /status schedule settings are persisted.
# Keep mutable state outside the source working tree in deployments.
STATUS_SCHEDULE_STATE_FILE=/var/lib/linux-monitor/state/bot/status_schedule_state.json
