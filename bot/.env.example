DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

MONITOR_API_BASE_URL=http://127.0.0.1:4040
POLL_INTERVAL_SECONDS=30
ALERT_GRACE_SECONDS=300

CPU_ALERT_THRESHOLD=85
MEMORY_ALERT_THRESHOLD=90
DISK_ALERT_THRESHOLD=90
GPU_TEMP_ALERT_THRESHOLD=80
GPU_USAGE_ALERT_THRESHOLD=85

ENABLE_DOCKER_ALERTS=true
ENABLE_RAID_ALERTS=true

MOBILE_PUSH_ENABLED=false
MOBILE_PUSH_INCLUDE_RECOVERY=true
MOBILE_PUSH_TOKEN_REGISTRY_FILE=/var/lib/linux-monitoring/mobile_push_tokens.json
MOBILE_PUSH_OUTBOX_FILE=/var/lib/linux-monitoring/mobile_push_delivery_state.json
MOBILE_PUSH_RETRY_INITIAL_SECONDS=30
MOBILE_PUSH_RETRY_MAX_SECONDS=900
FIREBASE_SERVICE_ACCOUNT_FILE=/etc/linux-monitor-mobile-alerts/firebase-service-account.json

# Optional: override where /status schedule settings are persisted.
# Relative paths are resolved from the bot directory.
STATUS_SCHEDULE_STATE_FILE=status_schedule_state.json

# Optional: override where active alert dedupe state is persisted.
# Relative paths are resolved from the bot directory.
ALERT_STATE_FILE=alert_state.json
