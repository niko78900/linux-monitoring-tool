# Generate a dedicated value; never reuse any existing Control Agent or alert token.
DASHBOARD_CONTROL_READ_TOKEN=replace-with-at-least-32-random-characters

# Documentation-only network. Replace both values with the Dashboard Docker
# bridge gateway and source subnet discovered on the deployment host.
DASHBOARD_CONTROL_BRIDGE_HOST=192.0.2.1
DASHBOARD_CONTROL_BRIDGE_PORT=4043
DASHBOARD_CONTROL_ALLOWED_NETWORKS=192.0.2.0/24

# Protected, host-local discovery configuration shared with the full agent.
KNOWN_DEVICES_CONFIG_PATH=/etc/linux-monitor/control-agent/known_devices.yaml
MANAGED_HOSTS_CONFIG_PATH=/etc/linux-monitor/control-agent/managed_hosts.yaml
SERVICES_CONFIG_PATH=/etc/linux-monitor/control-agent/services.yaml
