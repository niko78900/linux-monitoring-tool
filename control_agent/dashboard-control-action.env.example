# Generate a dedicated value; never reuse another Linux Monitor credential.
DASHBOARD_CONTROL_ACTION_TOKEN=replace-with-at-least-32-random-characters

# Documentation-only network. Replace both values with the exact Dashboard
# Docker bridge gateway and source subnet discovered on the deployment host.
DASHBOARD_CONTROL_ACTION_HOST=192.0.2.1
DASHBOARD_CONTROL_ACTION_PORT=4044
DASHBOARD_CONTROL_ACTION_ALLOWED_NETWORKS=192.0.2.0/24

# The registry is delivered through systemd LoadCredential. This fallback is
# useful for local tests only; production uses the credential copy.
DASHBOARD_ACTION_REGISTRY_PATH=/etc/linux-monitor/dashboard-managed-actions.yml
DASHBOARD_ACTION_DB_PATH=/var/lib/linux-monitor/dashboard-actions/dashboard-actions.db
DASHBOARD_ACTION_HELPER_PATH=/usr/local/libexec/linux-monitor-dashboard-action-helper
DASHBOARD_ACTION_WORKERS=1
DASHBOARD_ACTION_QUEUE_SIZE=32
DASHBOARD_ACTION_RETENTION_RECORDS=1000
DASHBOARD_ACTION_RETENTION_DAYS=90
