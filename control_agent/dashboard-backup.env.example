# Generate a dedicated value; never reuse another Linux Monitor credential.
DASHBOARD_BACKUP_TOKEN=replace-with-at-least-32-random-characters

# Documentation-only network. Replace these values with the exact Dashboard
# Docker bridge gateway and source subnet discovered on the deployment host.
DASHBOARD_BACKUP_HOST=192.0.2.1
DASHBOARD_BACKUP_PORT=4045
DASHBOARD_BACKUP_ALLOWED_NETWORKS=192.0.2.0/24

# Production receives the registry through systemd LoadCredential. This path is
# a local-development fallback only.
DASHBOARD_BACKUP_REGISTRY_PATH=/etc/linux-monitor/dashboard-backups.yml
DASHBOARD_BACKUP_DB_PATH=/var/lib/linux-monitor/dashboard-backups/dashboard-backups.db
DASHBOARD_BACKUP_HELPER_PATH=/usr/local/libexec/linux-monitor-dashboard-backup-helper
DASHBOARD_BACKUP_WORKERS=1
DASHBOARD_BACKUP_QUEUE_SIZE=16
DASHBOARD_BACKUP_HISTORY_RECORDS=5000
DASHBOARD_BACKUP_HISTORY_DAYS=365
