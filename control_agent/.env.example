APP_NAME=Homelab Control Agent
APP_VERSION=0.1.0
API_PREFIX=/api
HOST=127.0.0.1
PORT=4042
CORS_ORIGINS=http://localhost:4041,http://127.0.0.1:4041
CORS_ORIGIN_REGEX=
LOG_LEVEL=INFO
CONTROL_API_TOKEN=replace-with-long-random-token
MAIN_PC_MAC=AA:BB:CC:DD:EE:FF
WAKE_BROADCAST_HOST=255.255.255.255
WAKE_PORT=9
WAKE_RATE_LIMIT_SECONDS=30
KNOWN_DEVICES_CONFIG_PATH=/etc/linux-monitor/control-agent/known_devices.yaml
MANAGED_HOSTS_CONFIG_PATH=/etc/linux-monitor/control-agent/managed_hosts.yaml
SERVICES_CONFIG_PATH=/etc/linux-monitor/control-agent/services.yaml
SERVICE_CONTROL_HELPER_PATH=/usr/local/sbin/homelab-service-control
SERVICE_COMMAND_TIMEOUT_SECONDS=5
SERVICE_ACTION_STATE_PATH=/var/lib/linux-monitor/state/control-agent/service_actions.json
BENCHMARK_GPU_HELPER_PATH=/usr/local/sbin/homelab-vkmark-benchmark
BENCHMARK_MAX_DURATION_SECONDS=300
BENCHMARK_STDOUT_TAIL_LINES=80
