APP_NAME=Homelab Control Agent
APP_VERSION=0.1.0
API_PREFIX=/api
HOST=127.0.0.1
PORT=4042
LOG_LEVEL=INFO
CONTROL_API_TOKEN=replace-with-long-random-token
MAIN_PC_MAC=AA:BB:CC:DD:EE:FF
WAKE_BROADCAST_HOST=255.255.255.255
WAKE_PORT=9
WAKE_RATE_LIMIT_SECONDS=30
KNOWN_DEVICES_CONFIG_PATH=control_agent/config/known_devices.example.yaml
