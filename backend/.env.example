APP_NAME=Linux Server monitoring tool
APP_VERSION=0.2.0
API_PREFIX=/api
CORS_ORIGINS=http://localhost:4041,http://127.0.0.1:4041
CORS_ORIGIN_REGEX=
DISK_MOUNTPOINT=/
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=4040
RELOAD=false
DOCKER_TIMEOUT_SECONDS=3
HISTORY_ENABLED=true
HISTORY_DB_PATH=/var/lib/linux-monitoring/history.sqlite3
HISTORY_SAMPLE_INTERVAL_SECONDS=60
HISTORY_RETENTION_DAYS=30
HISTORY_RETENTION_CLEANUP_INTERVAL_SECONDS=3600
HISTORY_MAX_RESPONSE_POINTS=720
